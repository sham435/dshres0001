 sub.pack(pady=(0, 8))\n    \n            # Drag-and-browse zone\n            self.drop_frame = ttk.Frame(self.master, padding=12, relief=\"ridge\")\n            self.drop_frame.pack(fill=\"x\", padx=12, pady=(0, 8))\n            self.drop_label = tk.Label(self.drop_frame, text=\"Drop PDF here\", anchor=\"center\")\n            self.drop_label.pack(fill=\"both\", expand=True, pady=6)\n            self.drop_label.config(width=80, height=3)\n    \n            self.browse_btn = ttk.Button(self.drop_frame, text=\"Browse PDF\", command=self.browse_pdf)\n            self.browse_btn.pack(pady=(6, 0))\n    \n            # Progress\n            self.progress_frame = ttk.Frame(self.master, padding=(12, 6))\n            self.progress_frame.pack(fill=\"x\", padx=12)\n            self.progress_var = tk.DoubleVar(value=0.0)\n            self.progress_bar = ttk.Progressbar(self.progress_frame, variable=self.progress_var, maximum=100)\n            self.progress_bar.pack(fill=\"x\", padx=4, pady=(0, 4))\n            self.progress_label = tk.Label(self.progress_frame, text=\"Idle\")\n            self.progress_label.pack(anchor=\"w\")\n    \n            # Preview table\n            preview_frame = ttk.Frame(self.master, padding=12)\n            preview_frame.pack(fill=\"both\", expand=True, padx=12, pady=6)\n    \n            preview_label = tk.Label(preview_frame, text=\"Extracted Data Preview\", font=(\"Segoe UI\", 11, \"bold\"))\n            preview_label.pack(anchor=\"w\")\n    \n            self.tree = ttk.Treeview(preview_frame, columns=(\"field\", \"value\", \"page\", \"snippet\"), show=\"headings\")\n            self.tree.heading(\"field\", text=\"Field\")\n            self.tree.heading(\"value\", text=\"Value\")\n            self.tree.heading(\"page\", text=\"Page\")\n            self.tree.heading(\"snippet\", text=\"Snippet\")\n            self.tree.column(\"field\", width=180)\n            self.tree.column(\"value\", width=380)\n            self.tree.column(\"page\", width=60)\n            self.tree.column(\"snippet\", width=260)\n            self.tree.pack(fill=\"both\", expand=True, side=\"left\")\n    \n            self.tree_scroll = ttk.Scrollbar(preview_frame, orient=\"vertical\", command=self.tree.yview)\n            self.tree.configure(yscrollcommand=self.tree_scroll.set)\n            self.tree_scroll.pack(side=\"right\", fill=\"y\")\n    \n            # Controls\n            ctrl_frame = ttk.Frame(self.master, padding=12)\n            ctrl_frame.pack(fill=\"x\", padx=12, pady=(0, 12))\n    \n            self.save_btn = ttk.Button(ctrl_frame, text=\"Save to DB\", command=self.save_to_db, state=\"disabled\")\n            self.save_btn.pack(side=\"left\", padx=(0, 6))\n    \n            self.clear_btn = ttk.Button(ctrl_frame, text=\"Clear Preview\", command=self.clear_preview)\n            self.clear_btn.pack(side=\"left\", padx=(0, 6))\n    \n            self.export_btn = ttk.Button(ctrl_frame, text=\"Export CSV\", command=self.export_csv, state=\"disabled\")\n            self.export_btn.pack(side=\"left\", padx=(0, 6))\n    \n            # Status\n            self.status_frame = ttk.Frame(self.master, padding=6)\n            self.status_frame.pack(fill=\"x\", padx=12, pady=(0, 6))\n            self.status_label = tk.Label(self.status_frame, text=\"Ready\", anchor=\"w\")\n            self.status_label.pack(fill=\"x\")\n    \n        def _setup_dragdrop(self):\n            # Optional: enable OS-level drag/drop if library is available\n            if TKDND_AVAILABLE:\n                try:\n                    self.drop_label.bind(\"\u003cDragEnter\u003e\", lambda e: self.drop_label.config(relief=\"raised\"))\n                    self.drop_label.bind(\"\u003cDragLeave\u003e\", lambda e: self.drop_label.config(relief=\"flat\"))\n                    self.drop_label.bind(\"\u003cDrop\u003e\", self._on_drop_event)  # type: ignore\n                except Exception:\n                    pass\n            # Always enable click-to-browse\n            self.drop_label.bind(\"\u003cButton-1\u003e\", lambda e: self.browse_pdf())\n    \n        def _on_drop_event(self, event):\n            # event.data format varies, try to extract first path\n            data = event.data if hasattr(event, \"data\") else \"\"\n            path = data.strip().strip(\"{}\").strip('\"')\n            if path:\n                self.set_file_path(Path(path))\n    \n        def browse_pdf(self):\n            file_path = filedialog.askopenfilename(\n                title=\"Select PDF\",\n                filetypes=[(\"PDF files\", \"*.pdf\")],\n            )\n            if file_path:\n                self.set_file_path(Path(file_path))\n    \n        def set_file_path(self, path: Path):\n            self.file_path = path\n            self.drop_label.config(text=f\"Selected: {path.name}\\nClick Browse to change\")\n            # Start extraction automatically for a smoother flow\n            self.start_extraction()\n    \n        def start_extraction(self):\n            if not self.file_path or not self.file_path.exists():\n                messagebox.showwarning(\"No PDF\", \"Please select a valid PDF file.\")\n                return\n    \n            # Reset UI state\n            self._clear_results_ui()\n            self._update_progress(0, \"Starting extraction...\")\n    \n            # Run in background thread to keep UI responsive\n            t = threading.Thread(target=self._run_backend_extraction, daemon=True)\n            t.start()\n    \n        def _update_progress_ui(self, percent: int, message: str):\n            # Schedule UI updates on main thread\n            def _update():\n                self.progress_var.set(percent)\n                self.progress_label.config(text=f\"{percent}% - {message}\")\n                self.master.update_idletasks()\n            self.master.after(0, _update)\n    \n        def _run_backend_extraction(self):\n            # Provide a progress callback to the backend\n            def progress_cb(percent, message):\n                self._update_progress_ui(int(percent), message)\n    \n            try:\n                result = run_extraction_pipeline(\n                    self.file_path,\n                    user_id=self.user_id,\n                    db_path=Path(self.db_path),\n                    progress_callback=progress_cb,\n                )\n            except Exception as e:\n                self.master.after(0, lambda: messagebox.showerror(\"Extraction Error\", str(e)))\n                return\n    \n            self.extraction_result = result\n            self.preview_rows = result.valid_rows\n    \n            # Update UI with results\n            self.master.after(0, self._populate_preview)\n    \n            # Enable Save if there is data\n            can_save = len(result.valid_rows) \u003e 0\n            self.master.after(0, lambda: self.save_btn.config(state=\"normal\" if can_save else \"disabled\"))\n    \n            if result.errors:\n                self.master.after(0, lambda: self._show_errors(result.errors))\n            else:\n                self.master.after(0, lambda: self._update_progress_ui(100, \"Extraction complete\"))\n    \n        def _populate_preview(self):\n            # Clear existing rows\n            for row in self.tree.get_children():\n                self.tree.delete(row)\n    \n            # Display each extracted field as a row\n            for r in self.preview_rows:\n                self.tree.insert(\"\", \"end\", values=(r.field, r.value, r.page, r.raw_snippet))\n    \n            self.export_btn.config(state=\"normal\" if len(self.preview_rows) \u003e 0 else \"disabled\")\n            self.status_label.config(text=f\"Preview: {len(self.preview_rows)} fields extracted\")\n    \n        def _clear_results_ui(self):\n            self.tree.delete(*self.tree.get_children())\n            self.preview_rows = []\n            self.extraction_result = None\n            self.save_btn.config(state=\"disabled\")\n            self.export_btn.config(state=\"disabled\")\n            self.progress_var.set(0)\n            self.progress_label.config(text=\"Idle\")\n            self.status_label.config(text=\"Idle\")\n    \n        def clear_preview(self):\n            self._clear_results_ui()\n    \n        def _show_errors(self, errors: List[str]):\n            msg = \"\\n\".join(errors)\n            messagebox.showwarning(\"Extraction Warnings\", msg)\n    \n        def save_to_db(self):\n            if not self.preview_rows:\n                messagebox.showinfo(\"Nothing to save\", \"No extracted rows to save.\")\n                return\n    \n            db = SyllabusDB(Path(self.db_path))\n            inserted = db.insert_valid_rows_to_db(self.preview_rows, self.user_id)\n            messagebox.showinfo(\"Saved\", f\"Inserted {inserted} rows into the database.\")\n            self.status_label.config(text=f\"Saved {inserted} row(s) to DB\")\n            # After save, disable Save to prevent duplicate inserts until new data\n            self.save_btn.config(state=\"disabled\")\n    \n        def export_csv(self):\n            if not self.preview_rows:\n                messagebox.showinfo(\"No data\", \"No extracted data to export.\")\n                return\n            export_dir = Path(self.db_path).parent / \"exports\"\n            export_dir.mkdir(parents=True, exist_ok=True)\n            ts = int(time.time())\n            out_path = export_dir / f\"pdf_extract_{ts}.csv\"\n    \n            try:\n                with out_path.open(\"w\", encoding=\"utf-8\", newline=\"\") as f:\n                    f.write(\"field,value,page,raw_snippet\\n\")\n                    for r in self.preview_rows:\n                        line = f'\"{r.field}\",\"{r.value.replace(\"\\\"\",\"\\\"\\\"\")}\",{r.page},\"{r.raw_snippet.replace(\"\\\"\",\"\\\"\\\"\")}\"\\n'\n                        f.write(line)\n                messagebox.showinfo(\"Exported\", f\"CSV exported to: {out_path}\")\n            except Exception as e:\n                messagebox.showerror(\"Export failed\", str(e))\n    \n    def main():\n        user_id = 1  # For demo; replace with actual authenticated user_id in real app\n        # DB path is user-data location from the backend (consistent with pdf_auto_extract.py)\n        home_data = Path.cwd() / \"data\"  # Fallback if backend uses that\n        # Try to mimic backend's usual path (fallback gracefully)\n        db_path = Path.home() / \".smart_teacher\" / \"data\" / \"smart_teacher.db\"\n        db_path.parent.mkdir(parents=True, exist_ok=True)\n    \n        root = PdfExtractUI\n        # If tkinterdnd2 available, use its enhanced root class; otherwise standard Tk\n        if TKDND_AVAILABLE:\n            root = import(\"tkinter\").Tk  # minimal fallback to avoid import-time issues\n            root = root()  # type: ignore\n            # Note: Incomplete drag-drop wiring here if using tkinterdnd2; still works with Browse\n        else:\n            import tkinter as tk\n            root = tk.Tk()\n    \n        app = PdfExtractUI(root, user_id=user_id, db_path=str(db_path))\n        root.mainloop()\n    \n    if name == \"main\":\n        main()\n    \n    How to use\n    - Prerequisites:\n      - Python 3.11+\n      - pip install pdfplumber pandas\n      - Optional: pip install pyqt5 if you later switch to PyQt\n      - If you want real drag-and-drop: pip install tkinterdnd2 (and ensure the module loads)\n    - Drop-in behavior:\n      - Run: python pdf_extract_ui.py\n      - Click Browse PDF to select a file if drag/drop isn’t available\n      - The UI shows a progress bar as extraction runs\n      - Preview the extracted fields; click Save to DB to persist in the per-teacher DB\n      - Use Export CSV to export the preview for debugging or inspection\n    - Integration note:\n      - The UI relies on the backend functions you supplied in Chat 1:\n        - run_extraction_pipeline for extraction\n        - SyllabusDB.inser