        def _browse_file(self):
            file_path = filedialog.askopenfilename(filetypes=[(&quot;PDF Files&quot;, &quot;*.pdf&quot;)])
            if file_path:
                self._on_file_selected(Path(file_path))
    
        def _on_drop(self, event):
            # event.data may contain a path string or list
            data = event.data if hasattr(event, &quot;data&quot;) else &quot;&quot;
            files = self._parse_dropped_files(data)
            for f in files:
                self._on_file_selected(Path(f))
    
        @staticmethod
        def _parse_dropped_files(data: str) -&gt; List[str]:
            if not data:
                return []
            paths = []
            for part in data.split():
                p = part.strip()
                if p.startswith(&quot;{&quot;) and p.endswith(&quot;}&quot;):
                    p = p[1:-1]
                paths.append(p)
            return paths
    
        def _on_file_selected(self, path: Path):
            self.current_file = path
            self.file_label_var.set(str(path.name))
            if not self.current_user_id:
                messagebox.showwarning(&quot;Missing User&quot;, &quot;Please select a user before extracting.&quot;)
                return
            # Start extraction in background thread to keep UI responsive
            threading.Thread(target=self._start_extraction, args=(path,), daemon=True).start()
    
        def _start_extraction(self, file_path: Path):
            self._set_idle_state()
            user_id = self.current_user_id
            db_path = self.db_path
    
            # Progress callback for UI
            def progress_cb(percent, message):
                # Schedule UI updates on main thread
                self.after(0, lambda: self._set_progress(percent, message))
    
            self.extracted_rows = []
            self._clear_preview(no_reset_file_label=True)
            self._set_progress(0, &quot;Opening PDF...&quot;)
    
            result = run_extraction_pipeline(
                file_path,
                user_id,
                db_path,
                progress_callback=progress_cb
            )
    
            # Show results
            self.extracted_rows = result.valid_rows
            self.after(0, lambda: self._populate_preview(self.extracted_rows))
    
            if self.extracted_rows:
                self.after(0, lambda: self.save_btn.config(state=&quot;normal&quot;))
                self.after(0, lambda: self.export_btn.config(state=&quot;normal&quot;))
                self.after(0, lambda: self._set_progress(100, f&quot;Extraction complete: {len(self.extracted_rows)} rows&quot;))
                self.after(0, lambda: self.status_var.set(&quot;Extraction complete&quot;))
            else:
                # No data found or error
                if result.errors:
                    self.after(0, lambda: messagebox.showwarning(&quot;Extraction Errors&quot;, &quot;\n&quot;.join(result.errors)))
                    self.after(0, lambda: self.status_var.set(&quot;Extraction finished with errors&quot;))
                self.after(0, lambda: self._set_progress(0, &quot;Idle&quot;))
                self.after(0, lambda: self.save_btn.config(state=&quot;disabled&quot;))
                self.after(0, lambda: self.export_btn.config(state=&quot;disabled&quot;))
    
            return
    
        def _set_progress(self, percent: int, message: str):
            self.progress_bar[&#x27;value&#x27;] = max(0, min(100, int(percent)))
            self.progress_text.config(text=message)
    
        def _set_idle_state(self):
            self.progress_bar[&#x27;value&#x27;] = 0
            self.progress_text.config(text=&quot;Idle&quot;)
            self.status_var.set(&quot;Idle&quot;)
    
        def _populate_preview(self, rows: List[ExtractedRow]):
            self.tree.delete(*self.tree.get_children())
            for r in rows:
                self.tree.insert(&quot;&quot;, &quot;end&quot;, values=(r.field, r.value, r.page, r.raw_snippet))
    
        def _clear_preview(self, no_reset_file_label: bool = False):
            self.tree.delete(*self.tree.get_children())
            self.extracted_rows = []
            self.save_btn.config(state=&quot;disabled&quot;)
            self.export_btn.config(state=&quot;disabled&quot;)
            if not no_reset_file_label:
                self.file_label_var.set(&quot;No file loaded.&quot;)
            self.progress_bar[&#x27;value&#x27;] = 0
            self.progress_text.config(text=&quot;Idle&quot;)
            self.status_var.set(&quot;Idle&quot;)
    
        def _export_csv(self):
            if not self.extracted_rows:
                messagebox.showwarning(&quot;Export&quot;, &quot;No extracted data to export.&quot;)
                return
            df = []
            for r in self.extracted_rows:
                df.append({&quot;Field&quot;: r.field, &quot;Value&quot;: r.value, &quot;Page&quot;: r.page, &quot;Snippet&quot;: r.raw_snippet})
            df = pd.DataFrame(df)
    
            # Per-user export dir: /data/{user_id}/exports
            try:
                user_export_dir = Path(get_user_data_dir(self.user_id)).resolve()
            except Exception:
                user_export_dir = Path(&quot;exports&quot;).resolve()
            user_export_dir.mkdir(parents=True, exist_ok=True)
            export_path = user_export_dir / &quot;extracted_fields.csv&quot;
            df.to_csv(export_path, index=False, encoding=&quot;utf-8-sig&quot;)
            messagebox.showinfo(&quot;Export CSV&quot;, f&quot;CSV saved to: {export_path}&quot;)
    
        def _save_to_db(self):
            if not self.extracted_rows or not self.user_id:
