            label = self.user_var.get()
            self.current_user_id = self.user_map.get(label)
            if self.current_user_id:
                self.status_var.set(f&quot;Selected user_id={self.current_user_id}&quot;)
            else:
                self.status_var.set(&quot;No user selected&quot;)
            self._clear_preview()
    
